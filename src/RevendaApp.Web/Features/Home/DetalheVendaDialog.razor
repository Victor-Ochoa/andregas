@using RevendaApp.Domain.Enums
@using RevendaApp.Web.Common
@using RevendaApp.Web.Features.Home
@using Mediator

@inject ISender Sender

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Detalhe da venda</MudText>
    </TitleContent>
    <DialogContent>
        @if (_venda is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <div class="mb-4">
                <MudText Typo="Typo.subtitle1"><strong>@_venda.ClienteNome</strong> — @_venda.ClienteTelefone</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @_venda.DataHora.ToString("dd/MM/yyyy HH:mm") · @RotuloFormaPagamento(_venda.FormaPagamento) · @_venda.Status.Rotulo()
                </MudText>
            </div>

            <MudText Typo="Typo.subtitle2" Class="mb-2">Itens</MudText>
            <MudTable Items="_venda.Itens" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Produto</MudTh>
                    <MudTh>Qtd</MudTh>
                    <MudTh>Preço</MudTh>
                    <MudTh>Lucro</MudTh>
                    <MudTh>Empréstimo</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Produto">@context.ProdutoNome</MudTd>
                    <MudTd DataLabel="Qtd">@context.Quantidade</MudTd>
                    <MudTd DataLabel="Preço">@context.PrecoUnitario.ToString("C")</MudTd>
                    <MudTd DataLabel="Lucro">@context.LucroBruto.ToString("C")</MudTd>
                    <MudTd DataLabel="Empréstimo">
                        @(context.EhEmprestimo ? "Sim" : "-")
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <div class="mt-4 d-flex flex-column gap-1">
                <MudText Typo="Typo.body2">Subtotal (bruto): <span class="float-right">@Subtotal().ToString("C")</span></MudText>
                <MudText Typo="Typo.body2">Desconto: <span class="float-right">-@_venda.Desconto.ToString("C")</span></MudText>
                <MudText Typo="Typo.body2">Entrega: <span class="float-right">@_venda.ValorEntrega.ToString("C")</span></MudText>
                <MudDivider Class="my-0" />
                <MudText Typo="Typo.h6">Total: <span class="float-right">@_venda.ValorTotal.ToString("C")</span></MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Lucro: <span class="float-right">@_venda.LucroTotal.ToString("C")</span></MudText>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Fechar" Color="Color.Primary" Variant="Variant.Filled">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired]
    public Guid VendaId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private VendaParaDetalheResult? _venda;

    protected override async Task OnInitializedAsync()
    {
        _venda = await Sender.Send(new ObterVendaParaDetalheQuery(VendaId));
    }

    private decimal Subtotal() => _venda?.Itens.Sum(i => i.ValorTotal) ?? 0m;

    private void Fechar() => MudDialog.Close();

    private static string RotuloFormaPagamento(FormaPagamento forma) => forma.Rotulo();
}