@using RevendaApp.Domain.Enums
@using RevendaApp.Web.Features.Estoque.Editar
@using RevendaApp.Web.Features.Estoque.Movimentar
@using FluentValidation
@using Mediator

@inject ISender Sender
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">Produto: <strong>@ProdutoNome</strong></MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        <MudSelect T="TipoMovimentacaoEstoque" @bind-Value="_tipo" Label="Tipo de movimentação" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem T="TipoMovimentacaoEstoque" Value="TipoMovimentacaoEstoque.Entrada">Entrada</MudSelectItem>
            <MudSelectItem T="TipoMovimentacaoEstoque" Value="TipoMovimentacaoEstoque.Saida">Saída</MudSelectItem>
            <MudSelectItem T="TipoMovimentacaoEstoque" Value="TipoMovimentacaoEstoque.Ajuste">Ajuste (define o total em estoque)</MudSelectItem>
        </MudSelect>

        <MudNumericField T="int" @bind-Value="_quantidade" Label="@(_tipo == TipoMovimentacaoEstoque.Ajuste ? "Novo total em estoque" : "Quantidade")" Variant="Variant.Outlined" Class="mb-4" Min="1"
                         HelperText="@HelperQuantidade" />
        <MudTextField T="string" @bind-Value="_motivo" Label="Motivo (opcional)" Variant="Variant.Outlined" Class="mb-4" HelperText="Ex.: compra do fornecedor, produto avariado" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmarAsync" Disabled="_salvando">@(_tipo == TipoMovimentacaoEstoque.Ajuste ? "Ajustar estoque" : "Confirmar")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid ProdutoId { get; set; }

    [Parameter]
    public string ProdutoNome { get; set; } = "";

    private TipoMovimentacaoEstoque _tipo = TipoMovimentacaoEstoque.Entrada;
    private int _quantidade = 1;

    /// <summary>Helper do campo quantidade conforme o tipo (ajuste define o total).</summary>
    private string HelperQuantidade => _tipo == TipoMovimentacaoEstoque.Ajuste
        ? "Define o total; não soma à quantidade atual"
        : "Quantidade movimentada";
    private string? _motivo;
    private string? _errorMessage;
    private bool _salvando;

    private async Task ConfirmarAsync()
    {
        _salvando = true;
        _errorMessage = null;
        try
        {
            // A entrada (compra) de produto com controle de vasilhame consome vazios do depósito
            // (entregues ao fornecedor) — o handler valida e lança se não houver vazios suficientes.
            await Sender.Send(new RegistrarMovimentacaoEstoqueCommand(
                ProdutoId, _tipo, _quantidade, _motivo));
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
