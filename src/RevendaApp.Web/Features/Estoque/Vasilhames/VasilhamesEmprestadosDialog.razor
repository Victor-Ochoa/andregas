@using RevendaApp.Web.Features.Estoque.Vasilhames

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Vasilhames emprestados — @ProdutoNome</MudText>
    </TitleContent>
    <DialogContent>
        @if (EmprestimosPara is null || EmprestimosPara.Count == 0)
        {
            <MudText>Nenhum vasilhame emprestado no momento.</MudText>
        }
        else
        {
            <MudTable Items="EmprestimosPara" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Cliente</MudTh>
                    <MudTh>Quantidade</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Cliente">@context.ClienteNome</MudTd>
                    <MudTd DataLabel="Quantidade">@context.Quantidade</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Fechar">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string ProdutoNome { get; set; } = "";

    [Parameter]
    public IReadOnlyList<EmprestimoParaClienteItem>? EmprestimosPara { get; set; }

    private void Fechar() => MudDialog.Close();
}