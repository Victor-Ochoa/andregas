@rendermode InteractiveServer
@using RevendaApp.Web.Features.Vendas.NovaVenda

@inject IDialogService DialogService
@inject RevendaApp.Infrastructure.Tenancy.ITenantContext Tenant

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* "Nova Venda" é uma operação de domínio: no modo central (super admin sem empresa) não há
   tenant para vender e o modal estouraria em EmpresaIdRequerida. Mesma condição do menu de
   domínio no MainLayout. *@
@if (Tenant.EmpresaId is not null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PointOfSale" Class="mr-2 app-sale-button" OnClick="AbrirNovaVendaAsync">
        Nova Venda
    </MudButton>
}

<AuthorizeView>
    <Authorized>
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Dense="true">
            <MudMenuItem Disabled="true">@context.User.Identity?.Name</MudMenuItem>
            <MudDivider />
            @if (Tenant.Impersonando)
            {
                @* Mesmo padrão do "Sair": form POST nativo com antiforgery. O endpoint responde
                   redirect e a página recarrega por completo (forceLoad equivalente), descartando o
                   circuito com o principal impersonado. *@
                <MudMenuItem>
                    <form action="/central/voltar" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="mud-button-root mud-menu-item" style="background:none;border:none;width:100%;text-align:left;">
                            Voltar à central
                        </button>
                    </form>
                </MudMenuItem>
                <MudDivider />
            }
            @* "/configuracoes" é ApenasAdmin, e o super admin da central não tem a role Admin:
               no modo central o link levaria a /sem-autorizacao. Numa sessão impersonada ele É o
               admin da empresa (EmpresaId preenchido), então o item continua aparecendo. *@
            @if (Tenant.EmpresaId is not null)
            {
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" Href="/configuracoes">Configurações</MudMenuItem>
            }
            <MudDivider />
            <MudMenuItem>
                <form action="/logout" method="post">
                    <AntiforgeryToken />
                    <button type="submit" class="mud-button-root mud-menu-item" style="background:none;border:none;width:100%;text-align:left;">
                        Sair
                    </button>
                </form>
            </MudMenuItem>
        </MudMenu>
    </Authorized>
</AuthorizeView>

@code {
    private async Task AbrirNovaVendaAsync()
    {
        var dialog = await DialogService.ShowAsync<NovaVendaDialog>("Nova Venda", new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
        });

        await dialog.Result;
    }
}
