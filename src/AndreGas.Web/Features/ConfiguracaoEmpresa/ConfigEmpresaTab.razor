@using AndreGas.Web.Features.ConfiguracaoEmpresa
@using FluentValidation
@using Mediator

@inject ISender Sender
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject NavigationManager Navigation

@* Aba "Minha Empresa": o administrador da empresa edita o próprio cadastro.
   O Identificador aparece SOMENTE LEITURA (é imutável) e não há ação de ativar/inativar —
   essas operações são exclusivas da central do super admin. *@
@if (_carregando)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_detalhe is null)
{
    <MudAlert Severity="MudBlazor.Severity.Error">Não foi possível carregar os dados da empresa.</MudAlert>
}
else
{
    @* O Salvar roda no circuito (Blazor) e, ao terminar com sucesso, submete este form nativo
       (ver `SubmeterAtualizacaoSessaoAsync`). O POST com antiforgery reemite o cookie para o app bar
       pegar nome/cor novos. `display:none` porque o submit é programático. *@
    <form id="@IdFormularioAtualizacaoSessao" method="post"
          action="@ConfiguracaoEmpresaEndpoints.RotaAtualizarSessao" style="display:none">
        <AntiforgeryToken />
    </form>

    <MudText Typo="Typo.subtitle2" Class="mb-2">Dados da empresa</MudText>

    <MudTextField T="string" @bind-Value="_nome" Label="Nome" Variant="Variant.Outlined"
                  Class="mb-4" Required="true" MaxLength="200" />

    <MudTextField T="string" Value="_detalhe.Identificador" Label="Identificador"
                  Variant="Variant.Outlined" Class="mb-4" ReadOnly="true"
                  HelperText="O identificador não pode ser alterado." />

    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2">Contato e endereço (opcional)</MudText>

    <MudTextField T="string" @bind-Value="_cnpj" Label="CNPJ" Variant="Variant.Outlined" Class="mb-4" MaxLength="20" />
    <MudTextField T="string" @bind-Value="_endereco" Label="Logradouro" Variant="Variant.Outlined" Class="mb-4" MaxLength="300" />
    <div class="d-flex gap-4">
        <MudTextField T="string" @bind-Value="_numero" Label="Número" Variant="Variant.Outlined" Class="mb-4" MaxLength="20" />
        <MudTextField T="string" @bind-Value="_cep" Label="CEP" Variant="Variant.Outlined" Class="mb-4" MaxLength="10" />
    </div>
    <MudTextField T="string" @bind-Value="_bairro" Label="Bairro" Variant="Variant.Outlined" Class="mb-4" MaxLength="100" />
    <div class="d-flex gap-4">
        <MudTextField T="string" @bind-Value="_cidade" Label="Cidade" Variant="Variant.Outlined" Class="mb-4" MaxLength="100" />
        <MudTextField T="string" @bind-Value="_estado" Label="UF" Variant="Variant.Outlined" Class="mb-4" MaxLength="2" />
    </div>

    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2">Telefones</MudText>
    <div class="d-flex align-center gap-2 mb-4">
        <MudTextField T="string" @bind-Value="_novoTelefone" Label="Novo telefone" Variant="Variant.Outlined"
                      Class="flex-grow-1" />
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AdicionarTelefone"
                       Disabled="@string.IsNullOrWhiteSpace(_novoTelefone)" />
    </div>
    <MudChipSet T="string" Class="mb-4">
        @foreach (var telefone in _telefones.ToList())
        {
            <MudChip T="string" Size="Size.Small" OnClose="@(() => RemoverTelefone(telefone))">
                @telefone
            </MudChip>
        }
    </MudChipSet>

    <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2">Aparência</MudText>
    <div class="d-flex align-center gap-2 mb-4">
        <MudTextField T="string" @bind-Value="_corPrimaria" Label="Cor primária (hex)" Variant="Variant.Outlined"
                      Placeholder="#0A1F44" Class="flex-grow-1" MaxLength="9" />
        @if (CorValida)
        {
            <div style="width:36px;height:36px;border-radius:6px;border:1px solid #ccc;background:@_corPrimaria;"></div>
        }
    </div>

    <div class="d-flex align-center gap-2 mb-2">
        <InputFile OnChange="CarregarLogoAsync" accept="image/*" />
        @if (!string.IsNullOrEmpty(_logo))
        {
            <img src="@_logo" alt="Logo da empresa" style="height:48px;max-width:160px;object-fit:contain;" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="RemoverLogo" />
        }
    </div>
    <MudText Typo="Typo.caption" Color="Color.Secondary">Imagem PNG/JPG, até 500KB.</MudText>

    <div class="d-flex justify-end mt-6">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync"
                   Disabled="_salvando || _carregando">
            Salvar
        </MudButton>
    </div>
}

@code {
    /// <summary>Tamanho máximo do logo (o mesmo limite do domínio/configuração: ~500KB).</summary>
    private const long TamanhoMaximoLogoBytes = 500 * 1024;

    /// <summary>Id do form nativo de recarga da sessão (submetido via interop após salvar).</summary>
    private const string IdFormularioAtualizacaoSessao = "form-atualizar-sessao-empresa";

    private ConfigEmpresaDetalhe? _detalhe;
    private bool _carregando = true;
    private bool _salvando;

    private string _nome = "";
    private string? _cnpj;
    private string? _endereco;
    private string? _numero;
    private string? _cep;
    private string? _bairro;
    private string? _cidade;
    private string? _estado;
    private string? _corPrimaria;
    private string? _logo;
    private string? _novoTelefone;
    private List<string> _telefones = [];

    private bool CorValida =>
        !string.IsNullOrWhiteSpace(_corPrimaria)
        && System.Text.RegularExpressions.Regex.IsMatch(_corPrimaria.Trim(), "^#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})$");

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;
        try
        {
            _detalhe = await Sender.Send(new ObterConfigEmpresaQuery());
            if (_detalhe is null)
            {
                return;
            }

            _nome = _detalhe.Nome;
            _cnpj = _detalhe.Cnpj;
            _endereco = _detalhe.Endereco;
            _numero = _detalhe.Numero;
            _cep = _detalhe.Cep;
            _bairro = _detalhe.Bairro;
            _cidade = _detalhe.Cidade;
            _estado = _detalhe.Estado;
            _corPrimaria = _detalhe.CorPrimaria;
            _logo = _detalhe.Logo;
            _telefones = _detalhe.Telefones.ToList();
        }
        catch (InvalidOperationException ex)
        {
            // Modo central/sem empresa: a query lança EmpresaIdRequerida — mostra o motivo.
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
            _detalhe = null;
        }
        finally
        {
            _carregando = false;
        }
    }

    private void AdicionarTelefone()
    {
        var normalizado = new string(_novoTelefone!.Where(char.IsDigit).ToArray());
        if (normalizado.Length > 0 && !_telefones.Contains(normalizado))
        {
            _telefones.Add(normalizado);
        }

        _novoTelefone = null;
    }

    private void RemoverTelefone(string telefone) => _telefones.Remove(telefone);

    /// <summary>
    /// Lê a imagem escolhida e converte para data-uri base64. Recusa arquivos acima do limite com
    /// mensagem visível (o limite também é validado no servidor).
    /// </summary>
    private async Task CarregarLogoAsync(InputFileChangeEventArgs e)
    {
        var arquivo = e.File;
        if (arquivo.Size > TamanhoMaximoLogoBytes)
        {
            Snackbar.Add("A imagem do logo deve ter no máximo 500KB.", MudBlazor.Severity.Error);
            return;
        }

        using var stream = arquivo.OpenReadStream(TamanhoMaximoLogoBytes);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);

        _logo = $"data:{arquivo.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
    }

    private void RemoverLogo() => _logo = null;

    private async Task SalvarAsync()
    {
        _salvando = true;
        try
        {
            var editado = await Sender.Send(new EditarConfigEmpresaCommand(
                _nome, _cnpj, _endereco, _numero, _cep, _bairro, _cidade, _estado,
                _telefones, _corPrimaria, _logo));

            // `false` = a linha da empresa não existe mais (removida entre o load e o save). Sem este
            // ramo a tela diria "atualizados" para uma edição que não aconteceu.
            if (!editado)
            {
                Snackbar.Add("A empresa não foi encontrada. Recarregue a página e tente novamente.",
                    MudBlazor.Severity.Error);
                await CarregarAsync();
                return;
            }

            Snackbar.Add("Dados da empresa atualizados.", MudBlazor.Severity.Success);

            // Recarga completa de página: o POST reemite o cookie (nome/cor nas claims) e o app bar
            // passa a refletir a edição. Sem isto, o circuito atual (e um simples F5, que relê o
            // cookie antigo) continuaria com o branding velho.
            await SubmeterAtualizacaoSessaoAsync();
        }
        catch (ValidationException ex)
        {
            Snackbar.Add(string.Join(" ", ex.Errors.Select(erro => erro.ErrorMessage)), MudBlazor.Severity.Error);
        }
        catch (InvalidOperationException ex)
        {
            // Inclui EmpresaIdRequerida (modo central) e RequerAdminAsync (não-admin).
            Snackbar.Add(ex.Message, MudBlazor.Severity.Error);
        }
        catch (Exception)
        {
            // Rede de segurança: o formulário tem valores longos e a gravação pode falhar de formas
            // que não valem mapear uma a uma (ex.: coluna estourada, banco indisponível). Sem este
            // catch a exceção sobe pelo circuito, derruba a conexão e o admin perde o que digitou.
            Snackbar.Add("Não foi possível salvar os dados da empresa. Tente novamente.", MudBlazor.Severity.Error);
        }
        finally
        {
            _salvando = false;
        }
    }

    /// <summary>
    /// Submete o form nativo que faz o POST de recarga da sessão (o Blazor não navega um
    /// <c>&lt;form method="post"&gt;</c> sozinho). A navegação é de página completa por design.
    /// </summary>
    private async Task SubmeterAtualizacaoSessaoAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("andregas.submeterFormulario", IdFormularioAtualizacaoSessao);
        }
        catch (JSException)
        {
            // Fallback (ex.: interop indisponível no momento do submit): recarrega a página pelo
            // navegador, que também relê o cookie — porém com as claims ANTIGAS, então ao menos
            // avisamos que o branding pode exigir novo login.
            Snackbar.Add("Dados salvos. Saia e entre novamente para atualizar o nome exibido.",
                MudBlazor.Severity.Warning);
            Navigation.NavigateTo("/configuracoes", forceLoad: true);
        }
    }
}