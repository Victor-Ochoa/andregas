@page "/clientes/novo"
@rendermode InteractiveServer

@using AndreGas.Web.Features.Clientes.Cadastrar
@using FluentValidation
@using Mediator

@inject ISender Sender
@inject NavigationManager NavigationManager

<PageTitle>Novo Cliente — André Gas e Água</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Novo Cliente</MudText>

<MudPaper Class="pa-6" MaxWidth="600px" Style="max-width: 600px;">
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
    }

    <MudTextField T="string" @bind-Value="_nome" Label="Nome" Variant="Variant.Outlined" Class="mb-4" Required="true" />
    <MudTextField T="string" @bind-Value="_telefone" Label="Telefone" Variant="Variant.Outlined" Class="mb-4" Required="true" />
    <MudTextField T="string" @bind-Value="_endereco" Label="Endereço" Variant="Variant.Outlined" Class="mb-4" Required="true" />

    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync" Disabled="_salvando">
            Salvar
        </MudButton>
        <MudButton Variant="Variant.Text" Href="/clientes">Cancelar</MudButton>
    </div>
</MudPaper>

@code {
    private string _nome = "";
    private string _telefone = "";
    private string _endereco = "";
    private string? _errorMessage;
    private bool _salvando;

    private async Task SalvarAsync()
    {
        _salvando = true;
        _errorMessage = null;
        try
        {
            var clienteId = await Sender.Send(new CadastrarClienteCommand(_nome, _telefone, _endereco));
            NavigationManager.NavigateTo($"/clientes/{clienteId}");
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        finally
        {
            _salvando = false;
        }
    }
}
