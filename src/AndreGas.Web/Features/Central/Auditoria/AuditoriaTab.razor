@using AndreGas.Domain.Entities
@using AndreGas.Web.Common
@using AndreGas.Web.Features.Central.Auditoria
@using AndreGas.Web.Features.Central.ListarEmpresas
@using Mediator

@inject ISender Sender
@inject ILogger<AuditoriaTab> Logger

@* Aba "Auditoria" da central: trilha SOMENTE LEITURA das ações administrativas (empresas,
   usuários e "entrar como"). Não há comando de edição/exclusão de auditoria. *@

<div class="d-flex flex-wrap align-center gap-2 mb-4">
    <MudSelect T="string" @bind-Value="_filtroEmpresa" @bind-Value:after="RecarregarAsync"
               Label="Empresa" Variant="Variant.Outlined"
               Style="min-width: 240px;" Margin="Margin.Dense">
        <MudSelectItem T="string" Value="@string.Empty">Todas</MudSelectItem>
        @foreach (var empresa in _empresas)
        {
            <MudSelectItem T="string" Value="@empresa.Id.ToString()">@empresa.Nome</MudSelectItem>
        }
    </MudSelect>

    @* "Todas" é a string vazia: um MudSelect com T="string?" traria uma anotação de nulidade
       para o código gerado pelo compilador Razor (CS8669). O handler trata vazio como sem filtro. *@
    <MudSelect T="string" @bind-Value="_filtroAcao" @bind-Value:after="RecarregarAsync"
               Label="Ação" Variant="Variant.Outlined"
               Style="min-width: 220px;" Margin="Margin.Dense">
        <MudSelectItem T="string" Value="@string.Empty">Todas</MudSelectItem>
        @foreach (var acao in AcoesDisponiveis)
        {
            <MudSelectItem T="string" Value="@acao.Valor">@acao.Rotulo</MudSelectItem>
        }
    </MudSelect>

    <MudDatePicker @bind-Date="_de" @bind-Date:after="RecarregarAsync"
                   Label="De" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
    <MudDatePicker @bind-Date="_ate" @bind-Date:after="RecarregarAsync"
                   Label="Até" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />

    <MudSpacer />

    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RecarregarAsync">
        Atualizar
    </MudButton>
</div>

<MudTable T="AuditoriaItem" @ref="_tabela" ServerData="CarregarAsync" Hover="true" Dense="true"
          Breakpoint="Breakpoint.Md" Striped="true">
    <HeaderContent>
        <MudTh>Data/Hora</MudTh>
        <MudTh>Empresa</MudTh>
        <MudTh>Usuário</MudTh>
        <MudTh>Ação</MudTh>
        <MudTh>Detalhes</MudTh>
        <MudTh>Origem</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Data/Hora">
            @BrasilTimeZone.ParaBrasilia(context.DataHora).ToString("dd/MM/yyyy HH:mm")
        </MudTd>
        <MudTd DataLabel="Empresa">
            @(string.IsNullOrWhiteSpace(context.EmpresaNome) ? "Central" : context.EmpresaNome)
        </MudTd>
        <MudTd DataLabel="Usuário">@context.UsuarioNome</MudTd>
        <MudTd DataLabel="Ação">
            <MudChip T="string" Size="Size.Small" Color="@CorDaAcao(context.Acao)">@RotuloAcao(context.Acao)</MudChip>
        </MudTd>
        <MudTd DataLabel="Detalhes">
            <MudTooltip Text="@context.Detalhes" Placement="Placement.Bottom">
                <span class="d-inline-block text-truncate" style="max-width: 380px;">
                    @Resumir(context.Detalhes)
                </span>
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="Origem">@context.Origem</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>Nenhum registro de auditoria para os filtros aplicados.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager RowsPerPageString="Linhas por página: " InfoFormat="{first_item}-{last_item} de {all_items}" />
    </PagerContent>
</MudTable>

@code {
    /// <summary>Limite de caracteres do resumo na célula (o texto completo fica no tooltip).</summary>
    private const int LimiteResumo = 120;

    private MudTable<AuditoriaItem> _tabela = default!;
    private IReadOnlyList<EmpresaResumo> _empresas = [];

    private string _filtroEmpresa = string.Empty;
    private string _filtroAcao = string.Empty;
    private DateTime? _de;
    private DateTime? _ate;

    /// <summary>
    /// Ações auditáveis com rótulo pt-BR. Lista explícita (não enum): é a mesma fonte das constantes
    /// de <see cref="RegistroAuditoria.Acoes"/> e o filtro precisa mostrar o que existe na tela.
    /// </summary>
    private static readonly (string Valor, string Rotulo)[] AcoesDisponiveis =
    [
        (RegistroAuditoria.Acoes.EmpresaCriada, "Empresa criada"),
        (RegistroAuditoria.Acoes.EmpresaEditada, "Empresa editada"),
        (RegistroAuditoria.Acoes.EmpresaInativada, "Empresa inativada"),
        (RegistroAuditoria.Acoes.EmpresaReativada, "Empresa reativada"),
        (RegistroAuditoria.Acoes.UsuarioCriado, "Usuário criado"),
        (RegistroAuditoria.Acoes.UsuarioDesativado, "Usuário inativado"),
        (RegistroAuditoria.Acoes.UsuarioReativado, "Usuário reativado"),
        (RegistroAuditoria.Acoes.EntrarComo, "Entrar como"),
        (RegistroAuditoria.Acoes.ConfigEmpresaEditada, "Empresa editada (pelo admin)"),
    ];

    protected override async Task OnInitializedAsync()
    {
        // Empresas para o filtro: a central enxerga todas. Falha aqui não derruba a aba — sem a
        // lista o filtro por empresa fica só "Todas" e a auditoria continua legível.
        try
        {
            _empresas = await Sender.Send(new ListarEmpresasQuery());
        }
        catch (Exception excecao) when (excecao is not OperationCanceledException)
        {
            Logger.LogWarning(excecao, "Falha ao carregar as empresas para o filtro da aba Auditoria.");
            _empresas = [];
        }
    }

    private async Task<TableData<AuditoriaItem>> CarregarAsync(TableState state, CancellationToken cancellationToken)
    {
        var resultado = await Sender.Send(
            new ListarAuditoriaQuery(
                EmpresaId: Guid.TryParse(_filtroEmpresa, out var empresaFiltro) ? empresaFiltro : null,
                Acao: string.IsNullOrWhiteSpace(_filtroAcao) ? null : _filtroAcao,
                De: _de,
                Ate: _ate,
                Pagina: state.Page + 1,
                TamanhoPagina: state.PageSize),
            cancellationToken);

        return new TableData<AuditoriaItem>
        {
            Items = resultado.Itens,
            TotalItems = resultado.Total,
        };
    }

    private async Task RecarregarAsync()
    {
        if (_tabela is not null)
        {
            await _tabela.ReloadServerData();
        }
    }

    private static string RotuloAcao(string acao) =>
        AcoesDisponiveis.FirstOrDefault(a => a.Valor == acao).Rotulo ?? acao;

    private static Color CorDaAcao(string acao) => acao switch
    {
        RegistroAuditoria.Acoes.EmpresaCriada or RegistroAuditoria.Acoes.UsuarioCriado => Color.Success,
        RegistroAuditoria.Acoes.EmpresaInativada or RegistroAuditoria.Acoes.UsuarioDesativado => Color.Error,
        RegistroAuditoria.Acoes.EmpresaReativada or RegistroAuditoria.Acoes.UsuarioReativado => Color.Info,
        RegistroAuditoria.Acoes.EntrarComo => Color.Warning,
        _ => Color.Default,
    };

    /// <summary>
    /// Resumo de uma linha só para a célula (os detalhes são multi-linha com "antes → depois"). O
    /// texto completo continua disponível no tooltip.
    /// </summary>
    private static string Resumir(string detalhes)
    {
        var linha = detalhes.ReplaceLineEndings(" · ");

        // Truncar (e não linha[..LimiteResumo]) para não partir um par surrogate: meio par é texto
        // inválido e a célula renderizaria o caractere de substituição.
        return linha.Length <= LimiteResumo
            ? linha
            : RegistroAuditoria.Truncar(linha, LimiteResumo) + "…";
    }
}