@using AndreGas.Infrastructure.Identity
@using AndreGas.Web.Features.Central.UsuariosEmpresa
@using FluentValidation
@using Mediator

@inject ISender Sender

@* Usuários de uma empresa, gerenciados pela central (sem precisar "entrar como"). Lista, cria
   usuário (Admin/Vendedor) e inativa/reativa — com a guarda de "último administrador ativo" no
   servidor. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Usuários — @NomeEmpresa</MudText>
    </TitleContent>

    <DialogContent>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }
        @if (!string.IsNullOrEmpty(_sucessoMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Success" Class="mb-4">@_sucessoMessage</MudAlert>
        }

        <div class="d-flex align-center mb-4">
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                       OnClick="() => _mostrarFormulario = true" Disabled="_mostrarFormulario">
                Novo usuário
            </MudButton>
        </div>

        @if (_mostrarFormulario)
        {
            <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Novo usuário</MudText>

                <MudTextField T="string" @bind-Value="_nome" Label="Nome" Variant="Variant.Outlined" Class="mb-4" Required="true" />
                <MudTextField T="string" @bind-Value="_email" Label="E-mail (login)" Variant="Variant.Outlined" Class="mb-4" Required="true" />
                <MudSelect T="string" @bind-Value="_papel" Label="Papel" Variant="Variant.Outlined" Class="mb-4">
                    <MudSelectItem T="string" Value="@ApplicationRole.Admin">Administrador</MudSelectItem>
                    <MudSelectItem T="string" Value="@ApplicationRole.Vendedor">Vendedor</MudSelectItem>
                </MudSelect>
                <MudTextField T="string" @bind-Value="_senha" Label="Senha" Variant="Variant.Outlined"
                              InputType="InputType.Password" Class="mb-4" Required="true" />

                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CriarAsync" Disabled="_salvando">
                        Criar usuário
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelarFormulario" Disabled="_salvando">Cancelar</MudButton>
                </div>
            </MudPaper>
        }

        @if (_usuarios is null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_usuarios.Count == 0)
        {
            <MudText>Nenhum usuário cadastrado nesta empresa.</MudText>
        }
        else
        {
            <MudTable Items="_usuarios" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Nome</MudTh>
                    <MudTh>E-mail</MudTh>
                    <MudTh>Papel</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nome">@context.Nome</MudTd>
                    <MudTd DataLabel="E-mail">@context.Email</MudTd>
                    <MudTd DataLabel="Papel">
                        <MudChip T="string" Size="Size.Small" Color="@(context.Papel == ApplicationRole.Admin ? Color.Primary : Color.Default)">
                            @(context.Papel == ApplicationRole.Admin ? "Administrador" : "Vendedor")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@(context.Ativo ? Color.Success : Color.Default)"
                                 Variant="@(context.Ativo ? Variant.Filled : Variant.Outlined)">
                            @(context.Ativo ? "Ativo" : "Inativo")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Text" OnClick="@(() => AlternarAtivoAsync(context))" Disabled="_salvando">
                            @(context.Ativo ? "Inativar" : "Reativar")
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Fechar">Fechar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid EmpresaId { get; set; }

    [Parameter]
    public string NomeEmpresa { get; set; } = "";

    private IReadOnlyList<UsuarioEmpresaItem>? _usuarios;
    private bool _mostrarFormulario;
    private string _nome = "";
    private string _email = "";
    private string _papel = ApplicationRole.Vendedor;
    private string _senha = "";
    private string? _errorMessage;
    private string? _sucessoMessage;
    private bool _salvando;

    protected override async Task OnInitializedAsync() => await CarregarAsync();

    private async Task CarregarAsync()
    {
        _usuarios = await Sender.Send(new ListarUsuariosEmpresaQuery(EmpresaId));
    }

    private async Task CriarAsync()
    {
        _salvando = true;
        _errorMessage = null;
        _sucessoMessage = null;
        try
        {
            var resultado = await Sender.Send(new CriarUsuarioEmpresaCommand(
                EmpresaId, _nome, _email, _papel, _senha));

            if (!resultado.Sucesso)
            {
                _errorMessage = resultado.Erro;
                return;
            }

            _sucessoMessage = "Usuário criado.";
            CancelarFormulario();
            await CarregarAsync();
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        finally
        {
            _salvando = false;
        }
    }

    private async Task AlternarAtivoAsync(UsuarioEmpresaItem usuario)
    {
        _salvando = true;
        _errorMessage = null;
        _sucessoMessage = null;
        try
        {
            var resultado = await Sender.Send(new InativarUsuarioEmpresaCommand(EmpresaId, usuario.Id, !usuario.Ativo));

            if (!resultado.Sucesso)
            {
                _errorMessage = resultado.Erro;
                return;
            }

            _sucessoMessage = usuario.Ativo ? "Usuário inativado." : "Usuário reativado.";
            await CarregarAsync();
        }
        finally
        {
            _salvando = false;
        }
    }

    private void CancelarFormulario()
    {
        _mostrarFormulario = false;
        _nome = "";
        _email = "";
        _papel = ApplicationRole.Vendedor;
        _senha = "";
    }

    private void Fechar() => MudDialog.Close(DialogResult.Ok(true));
}