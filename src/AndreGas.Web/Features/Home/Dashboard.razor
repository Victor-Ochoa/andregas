@page "/"
@rendermode InteractiveServer

@using AndreGas.Domain.Enums
@using AndreGas.Web.Common
@using AndreGas.Web.Features.Home
@using AndreGas.Web.Features.Estoque.Vasilhames
@using AndreGas.Web.Features.Vendas.NovaVenda
@using Mediator

@inject ISender Sender
@inject VendasAtualizadasNotifier VendasNotifier
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Home — André Gas e Água</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Painel — André Gas e Água</MudText>

<MudTooltip Placement="Placement.Bottom">
    <ChildContent>
        <MudSelect T="PeriodoDashboard"
                   @bind-Value="_periodo"
                   @bind-Value:after="OnPeriodoChangedAsync"
                   Label="Período"
                   Variant="Variant.Outlined"
                   Class="mb-4"
                   Style="max-width: 260px;">
            @foreach (var periodo in _periodos)
            {
                <MudSelectItem T="PeriodoDashboard" Value="@periodo">@ObterRotuloPeriodo(periodo)</MudSelectItem>
            }
        </MudSelect>
    </ChildContent>
    <TooltipContent>
        <MudText>Define a janela de tempo usada para calcular as métricas dos cartões e do gráfico abaixo.</MudText>
    </TooltipContent>
</MudTooltip>

@if (_dashboard is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Vendas no período</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <MudText>
                            Soma dos valores totais (já líquidos de desconto) de todas as vendas no período selecionado,
                            independentemente da forma de pagamento — Pix, Débito, Crédito, Dinheiro, Gás do Povo e
                            Fiado (venda fiado conta como venda, mesmo não tendo sido paga).
                        </MudText>
                    </TooltipContent>
                </MudTooltip>
                <MudText Typo="Typo.h5">@_dashboard.VendasTotal.ToString("C")</MudText>
                <MudText Typo="Typo.caption">@_dashboard.VendasQuantidade venda(s)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Lucro no período</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <MudText>
                            Lucro reconhecido no período: soma do lucro líquido (preço de venda − custo, já descontado o
                            desconto rateado) apenas das vendas efetivamente pagas no período. Vendas fiado em aberto
                            <b>não</b> entram — o lucro do fiado só é reconhecido quando o saldo devedor é pago.
                        </MudText>
                    </TooltipContent>
                </MudTooltip>
                <MudText Typo="Typo.h5">@_dashboard.LucroTotal.ToString("C")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Desconto no período</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <MudText>
                            Soma dos descontos concedidos nas vendas do período. O desconto é um valor único por venda
                            (inicia zerado), abatido do valor bruto e rateado proporcionalmente entre os itens,
                            reduzindo o lucro líquido de cada item.
                        </MudText>
                    </TooltipContent>
                </MudTooltip>
                <MudText Typo="Typo.h5">@_dashboard.DescontoTotal.ToString("C")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4">
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total devedor (fiado)</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <MudText>
                            Soma de todos os saldos devedores em aberto dos clientes (fiado), independentemente do
                            período selecionado — reflete o valor total ainda a receber da revendedora.
                        </MudText>
                    </TooltipContent>
                </MudTooltip>
                <MudText Typo="Typo.h5">@_dashboard.TotalDevedor.ToString("C")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudText Typo="Typo.h6" Class="mb-2">Pagamentos no período (@ObterRotuloPeriodo(_periodo))</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <MudText>
                            Registros de pagamentos recebidos no período: vendas pagas no ato (Pix, Débito, Crédito,
                            Dinheiro, Gás do Povo) e abatimentos de saldo devedor (fiado). Fiado nunca aparece como
                            forma de pagamento aqui.
                        </MudText>
                    </TooltipContent>
                </MudTooltip>
                @if (_dashboard.Pagamentos.Count == 0)
                {
                    <MudText>Nenhum pagamento registrado neste período.</MudText>
                }
                else
                {
                    <MudTable T="PagamentoDetalhe" Items="_dashboard.Pagamentos" Dense="true" Hover="true"
                              Breakpoint="Breakpoint.Sm" Striped="true">
                        <HeaderContent>
                            <MudTh>Data</MudTh>
                            <MudTh>Cliente</MudTh>
                            <MudTh>Forma</MudTh>
                            <MudTh>Valor</MudTh>
                            <MudTh>Observação</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Data">@context.Data.ToString("dd/MM HH:mm")</MudTd>
                            <MudTd DataLabel="Cliente">@context.ClienteNome</MudTd>
                            <MudTd DataLabel="Forma">@ObterFormaPagamento(context.FormaPagamento)</MudTd>
                            <MudTd DataLabel="Valor">@context.Valor.ToString("C")</MudTd>
                            <MudTd DataLabel="Observação">@(context.Observacao ?? "-")</MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTFootRow>
                                <MudTd colspan="3"><MudText Typo="Typo.subtitle2">Total do período</MudText></MudTd>
                                <MudTd><MudText Typo="Typo.subtitle2">@_dashboard.Pagamentos.Sum(p => p.Valor).ToString("C")</MudText></MudTd>
                                <MudTd></MudTd>
                            </MudTFootRow>
                        </FooterContent>
                        <PagerContent>
                            <MudTablePager RowsPerPageString="Linhas por página: " InfoFormat="{first_item}-{last_item} de {all_items}" />
                        </PagerContent>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4">
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudText Typo="Typo.h6" Class="mb-2">Vendas no período (@ObterRotuloPeriodo(_periodo))</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <MudText>
                            Vendas realizadas no período, em ordem decrescente de data. Inclui todas as formas de
                            pagamento (inclusive fiado). Lucro exibido é o lucro reconhecido: vendas fiado em aberto
                            mostram lucro zero aqui, pois só é reconhecido quando o saldo é pago.
                        </MudText>
                    </TooltipContent>
                </MudTooltip>
                @if (_dashboard.Vendas.Count == 0)
                {
                    <MudText>Nenhuma venda registrada neste período.</MudText>
                }
                else
                {
                    @if (_filtroAtivo)
                    {
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="mb-2" Variant="Variant.Outlined">
                            Filtro ativo: @_filtroDescricao
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="LimparFiltro" Class="ml-1" />
                        </MudChip>
                    }
                    <MudTable T="VendaDetalhe" Items="_vendasFiltradas" Dense="true" Hover="true"
                              Breakpoint="Breakpoint.Sm" Striped="true"
                              OnRowClick="@(e => AbrirDetalheVendaAsync(e.Item))">
                        <HeaderContent>
                            <MudTh>Data</MudTh>
                            <MudTh>Cliente</MudTh>
                            <MudTh>Forma</MudTh>
                            <MudTh>Qtd de itens</MudTh>
                            <MudTh>Desconto</MudTh>
                            <MudTh>Entrega</MudTh>
                            <MudTh>Total</MudTh>
                            <MudTh>Lucro</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Data">@context.DataHora.ToString("dd/MM HH:mm")</MudTd>
                            <MudTd DataLabel="Cliente">@context.ClienteNome</MudTd>
                            <MudTd DataLabel="Forma">@ObterFormaPagamento(context.FormaPagamento)</MudTd>
                            <MudTd DataLabel="Qtd de itens">@context.QuantidadeItens</MudTd>
                            <MudTd DataLabel="Desconto">@context.Desconto.ToString("C")</MudTd>
                            <MudTd DataLabel="Entrega">@context.ValorEntrega.ToString("C")</MudTd>
                            <MudTd DataLabel="Total">@context.ValorTotal.ToString("C")</MudTd>
                            <MudTd DataLabel="Lucro">@context.Lucro.ToString("C")</MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTFootRow>
                                <MudTd colspan="6"><MudText Typo="Typo.subtitle2">Total do período</MudText></MudTd>
                                <MudTd><MudText Typo="Typo.subtitle2">@_vendasFiltradas.Sum(v => v.ValorTotal).ToString("C")</MudText></MudTd>
                                <MudTd><MudText Typo="Typo.subtitle2">@_vendasFiltradas.Sum(v => v.Lucro).ToString("C")</MudText></MudTd>
                            </MudTFootRow>
                        </FooterContent>
                        <PagerContent>
                            <MudTablePager RowsPerPageString="Linhas por página: " InfoFormat="{first_item}-{last_item} de {all_items}" />
                        </PagerContent>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-4">
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Possível recompra</MudText>
                <MudText Typo="Typo.caption" Class="mb-2" Color="Color.Secondary">
                    Clientes que já passaram da data prevista de nova compra. Ligue e pergunte se precisa.
                </MudText>
                @if (_dashboard!.Recompras.Count == 0)
                {
                    <MudText>Nenhuma recompra pendente. 👍</MudText>
                }
                else
                {
                    <MudTable T="RecompraItem" Items="_dashboard!.Recompras" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Cliente</MudTh>
                            <MudTh>Produto</MudTh>
                            <MudTh>Última compra</MudTh>
                            <MudTh>Intervalo</MudTh>
                            <MudTh>Dias desde a prevista</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Cliente">@context.ClienteNome</MudTd>
                            <MudTd DataLabel="Produto">@context.ProdutoNome</MudTd>
                            <MudTd DataLabel="Última compra">@context.DataUltimaCompra.ToString("dd/MM/yyyy")</MudTd>
                            <MudTd DataLabel="Intervalo">~@((int)context.IntervaloMedioDias) dias</MudTd>
                            <MudTd DataLabel="Dias desde a prevista">@context.DiasDecorridos dia(s)</MudTd>
                            <MudTd>
                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                           OnClick="@(() => AbrirNovaVendaClienteAsync(context.ClienteId, context.ProdutoId))">
                                    Registrar venda
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-4">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Estoque baixo</MudText>
                @if (_dashboard.ProdutosEstoqueBaixo.Count == 0)
                {
                    <MudText>Nenhum produto com estoque baixo. 👍</MudText>
                }
                else
                {
                    <MudList T="string">
                        @foreach (var produto in _dashboard.ProdutosEstoqueBaixo)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Warning" IconColor="Color.Error">
                                @produto.Nome — @produto.QuantidadeEstoque un. (mínimo @produto.EstoqueMinimo)
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Top devedores (fiado)</MudText>
                @if (_dashboard.TopDevedores.Count == 0)
                {
                    <MudText>Nenhum cliente com saldo devedor. 🎉</MudText>
                }
                else
                {
                    <MudList T="TopDevedorItem">
                        @foreach (var devedor in _dashboard.TopDevedores)
                        {
                            <MudListItem T="TopDevedorItem" Icon="@Icons.Material.Filled.Person" IconColor="Color.Warning"
                                         OnClick="@(() => AbrirFichaCliente(devedor.ClienteId))">
                                @devedor.Nome — @devedor.SaldoDevedor.ToString("C")
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Top produtos vendidos</MudText>
                @if (_dashboard.TopProdutos.Count == 0)
                {
                    <MudText>Nenhum produto vendido neste período.</MudText>
                }
                else
                {
                    <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="_serieTopProdutos" ChartLabels="_rotuloTopProdutos"
                              Width="100%" Height="240px"
                              SelectedIndex="_indiceTopProdutoSelecionado"
                              SelectedIndexChanged="TopProdutoSelecionadoMudou" />
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        @foreach (var produto in _dashboard.TopProdutos)
                        {
                            <MudChip T="Guid" Color="@(_filtroProdutoId == produto.ProdutoId ? Color.Primary : Color.Default)"
                                     Variant="@(_filtroProdutoId == produto.ProdutoId ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => AplicarFiltroProduto(produto.ProdutoId))">
                                @produto.Nome — @produto.QuantidadeTotal un
                            </MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">Clique em um produto (ou barra) para filtrar a tabela de vendas.</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-4">
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudText Typo="Typo.h6" Class="mb-2">Produtos</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <MudText>
                            Situação de cada produto: Estoque (cheios em estoque), Vasilhame (vazios
                            disponíveis no depósito) e Emprestado (vazios emprestados a clientes).
                            Produtos sem controle de vasilhame ficam com Vasilhame e Emprestado zerados.
                        </MudText>
                    </TooltipContent>
                </MudTooltip>
                @if (_dashboard.Vasilhames.Count == 0)
                {
                    <MudText>Nenhum produto cadastrado.</MudText>
                }
                else
                {
                    <MudChart T="double" ChartType="ChartType.StackedBar" ChartSeries="_serieVasilhames" ChartLabels="_rotuloVasilhames"
                              Width="100%" Height="280px" />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-4">
        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4">
                <MudTooltip Placement="Placement.Top">
                    <ChildContent>
                        <MudText Typo="Typo.h6" Class="mb-2">Vendas no período (@ObterRotuloPeriodo(_periodo))</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <MudText>
                            Linha azul: total de vendas (todas as formas de pagamento, incluindo fiado), agregado por
                            hora (períodos até 24h) ou por dia (períodos maiores). Linha verde: lucro reconhecido —
                            apenas vendas pagas (Pix, Débito, Crédito, Dinheiro, Gás do Povo) e fiado já quitado.
                            Vendas fiado em aberto contam no total, mas não no lucro.
                        </MudText>
                    </TooltipContent>
                </MudTooltip>
                @if (_dashboard.VendasPorPeriodo.Count == 0)
                {
                    <MudText>Nenhuma venda registrada neste período ainda.</MudText>
                }
                else
                {
                    <MudChart T="double" ChartType="ChartType.Line" ChartSeries="_serieVendas" ChartLabels="_rotulosPeriodo"
                              Width="100%" Height="300px" />
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">Vendas por forma de pagamento</MudText>
                @if (_dashboard.VendasPorForma.Count == 0)
                {
                    <MudText>Nenhuma venda neste período.</MudText>
                }
                else
                {
                    <MudChart T="double" ChartType="ChartType.Donut" ChartSeries="_serieFormas" ChartLabels="_rotuloFormas"
                              Width="100%" Height="240px" ChartOptions="_opcoesDonut" />
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        @foreach (var forma in _dashboard.VendasPorForma)
                        {
                            <MudChip T="FormaPagamento" Color="@(_filtroForma == forma.FormaPagamento ? Color.Primary : Color.Default)"
                                     Variant="@(_filtroForma == forma.FormaPagamento ? Variant.Filled : Variant.Outlined)"
                                     OnClick="@(() => AplicarFiltroForma(forma.FormaPagamento))">
                                @ObterFormaPagamento(forma.FormaPagamento) — @forma.Valor.ToString("C")
                            </MudChip>
                        }
                    </div>
                    <MudText Typo="Typo.caption" Class="mt-2" Color="Color.Secondary">Clique em uma forma para filtrar a tabela de vendas.</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private DashboardResult? _dashboard;
    private List<ChartSeries<double>> _serieVendas = [];
    private string[] _rotulosPeriodo = [];
    private IDisposable? _subscription;

    // Gráficos com ação
    private List<ChartSeries<double>> _serieFormas = [];
    private string[] _rotuloFormas = [];
    private int _indiceFormaSelecionada = -1;

    // O donut já tem os chips de valor (rótulo + valor, clicáveis) como legenda logo abaixo; a
    // legenda embutida do MudChart sobrepõe o gráfico em containers estreitos. Desabilita-a.
    private MudBlazor.DonutChartOptions? _opcoesDonut;

    protected override void OnInitialized()
    {
        _opcoesDonut = new MudBlazor.DonutChartOptions { ShowLegend = false };
    }

    private List<ChartSeries<double>> _serieTopProdutos = [];
    private string[] _rotuloTopProdutos = [];
    private int _indiceTopProdutoSelecionado = -1;

    // Gráfico de produtos (Estoque × Vasilhame × Emprestado) — todos os produtos, visível a todos.
    private List<ChartSeries<double>> _serieVasilhames = [];
    private string[] _rotuloVasilhames = [];

    // Filtro ativo sobre a tabela de vendas (via donut ou top produtos).
    private FormaPagamento? _filtroForma;
    private Guid? _filtroProdutoId;
    private string _filtroDescricao = "";

    private static readonly PeriodoDashboard[] _periodos =
    [
        PeriodoDashboard.UltimaHora,
        PeriodoDashboard.Ultimas3Horas,
        PeriodoDashboard.Hoje,
        PeriodoDashboard.Ultimas24Horas,
        PeriodoDashboard.Ultimos7Dias,
        PeriodoDashboard.EsteMes,
        PeriodoDashboard.Tudo,
    ];

    private PeriodoDashboard _periodo = PeriodoDashboard.Hoje;

    protected override async Task OnInitializedAsync()
    {
        _subscription = VendasNotifier.Subscribe(RecarregarAsync);
        await RecarregarAsync();
    }

    private async Task OnPeriodoChangedAsync()
    {
        await RecarregarAsync();
    }

    private async Task RecarregarAsync()
    {
        _dashboard = await Sender.Send(new ObterDashboardQuery(_periodo));

        _rotulosPeriodo = _dashboard.VendasPorPeriodo.Select(v => v.Rotulo).ToArray();
        _serieVendas =
        [
            new ChartSeries<double> { Name = "Vendas (R$)", Data = _dashboard.VendasPorPeriodo.Select(v => (double)v.Total).ToArray() },
            new ChartSeries<double> { Name = "Lucro (R$)", Data = _dashboard.VendasPorPeriodo.Select(v => (double)v.Lucro).ToArray() },
        ];

        _rotuloFormas = _dashboard.VendasPorForma.Select(f => ObterFormaPagamento(f.FormaPagamento)).ToArray();
        _serieFormas =
        [
            new ChartSeries<double> { Name = "Vendas", Data = _dashboard.VendasPorForma.Select(f => (double)f.Valor).ToArray() },
        ];

        _rotuloTopProdutos = _dashboard.TopProdutos.Select(p => p.Nome).ToArray();
        _serieTopProdutos =
        [
            new ChartSeries<double> { Name = "Quantidade", Data = _dashboard.TopProdutos.Select(p => (double)p.QuantidadeTotal).ToArray() },
        ];

        var graficoVasilhames = VasilhameGraficoBuilder.Construir(_dashboard.Vasilhames);
        _serieVasilhames = graficoVasilhames.Series.ToList();
        _rotuloVasilhames = graficoVasilhames.Labels;

        _indiceFormaSelecionada = -1;
        _indiceTopProdutoSelecionado = -1;
        _filtroForma = null;
        _filtroProdutoId = null;
        _filtroDescricao = "";

        // O notifier chama este método a partir de outro componente (modal de venda) no mesmo
        // circuito. Sem chamar StateHasChanged o Blazor Server não re-renderiza após a venda,
        // deixando o dashboard com valores desatualizados até um refresh manual.
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Abre a Nova Venda com o cliente do aviso de recompra pré-selecionado, agilizando o registro
    /// da venda para quem já passou da data prevista de nova compra.
    /// </summary>
    private async Task AbrirNovaVendaClienteAsync(Guid clienteId, Guid? produtoId = null)
    {
        var parameters = new DialogParameters<NovaVendaDialog>
        {
            { x => x.ClienteInicialId, clienteId },
            { x => x.ProdutoInicialId, produtoId },
        };
        // Mesmo tamanho do botão superior (menu): largura média + full width, para a modal abrir
        // igual em qualquer origem.
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
        };
        await DialogService.ShowAsync<NovaVendaDialog>("Nova Venda", parameters, options);
    }

    private async Task AbrirDetalheVendaAsync(VendaDetalhe? venda)
    {
        if (venda is null)
        {
            return;
        }

        var parameters = new DialogParameters<DetalheVendaDialog>
        {
            { x => x.VendaId, venda.VendaId },
        };

        await DialogService.ShowAsync<DetalheVendaDialog>("Detalhe da venda", parameters);
    }

    private void FormaSelecionadaMudou(int indice)
    {
        _indiceFormaSelecionada = indice;

        if (_dashboard is null || indice < 0 || indice >= _dashboard.VendasPorForma.Count)
        {
            _filtroForma = null;
            _filtroDescricao = "";
            return;
        }

        AplicarFiltroForma(_dashboard.VendasPorForma[indice].FormaPagamento);
    }

    private void AplicarFiltroForma(FormaPagamento forma)
    {
        _filtroForma = forma;
        _filtroProdutoId = null;
        _filtroDescricao = $"Forma: {ObterFormaPagamento(forma)}";
    }

    private void TopProdutoSelecionadoMudou(int indice)
    {
        _indiceTopProdutoSelecionado = indice;

        if (_dashboard is null || indice < 0 || indice >= _dashboard.TopProdutos.Count)
        {
            _filtroProdutoId = null;
            _filtroDescricao = "";
            return;
        }

        AplicarFiltroProduto(_dashboard.TopProdutos[indice].ProdutoId);
    }

    private void AplicarFiltroProduto(Guid produtoId)
    {
        _filtroProdutoId = produtoId;
        _filtroForma = null;
        _filtroDescricao = $"Produto: {_dashboard?.TopProdutos.FirstOrDefault(p => p.ProdutoId == produtoId)?.Nome ?? "?"}";
    }

    private void AbrirFichaCliente(Guid clienteId) => NavigationManager.NavigateTo($"/clientes/{clienteId}");

    private void LimparFiltro()
    {
        _filtroForma = null;
        _filtroProdutoId = null;
        _filtroDescricao = "";
        _indiceFormaSelecionada = -1;
        _indiceTopProdutoSelecionado = -1;
    }

    private bool _filtroAtivo => _filtroForma is not null || _filtroProdutoId is not null;

    private IReadOnlyList<VendaDetalhe> _vendasFiltradas
    {
        get
        {
            if (!_filtroAtivo || _dashboard is null)
            {
                return _dashboard?.Vendas ?? [];
            }

            return _dashboard.Vendas.Where(v =>
                    (_filtroForma is null || v.FormaPagamento == _filtroForma) &&
                    (_filtroProdutoId is null || v.ProdutoIds.Contains(_filtroProdutoId.Value)))
                .ToList();
        }
    }

    private static string ObterRotuloPeriodo(PeriodoDashboard periodo) => periodo.Rotulo();

    private static string ObterFormaPagamento(FormaPagamento forma) => forma.Rotulo();

    public void Dispose() => _subscription?.Dispose();
}
