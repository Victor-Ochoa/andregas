@using AndreGas.Domain.Enums
@using AndreGas.Web.Common
@using AndreGas.Web.Features.Estoque.Listar
@using AndreGas.Web.Features.Vendas.NovaVenda
@using FluentValidation
@using Mediator

@inject ISender Sender
@inject VendasAtualizadasNotifier VendasNotifier

<MudDialog>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_telefone" Label="Telefone do cliente" Variant="Variant.Outlined"
                       Class="mb-2" Immediate="true" DebounceInterval="1000" OnDebounceIntervalElapsed="BuscarClienteAsync"
                       OnBlur="BuscarClienteAsync" />

        @if (_clienteEncontrado is not null)
        {
            <MudAlert Severity="MudBlazor.Severity.Success" Class="mb-4">
                Cliente: <strong>@_clienteEncontrado.Nome</strong> — @_clienteEncontrado.Endereco<br />
                Saldo devedor atual: @_clienteEncontrado.SaldoDevedor.ToString("C")
            </MudAlert>
        }
        else if (_telefonePesquisado)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-4">
                Cliente não encontrado. Preencha os dados abaixo para cadastrá-lo.
            </MudAlert>
            <MudTextField T="string" @bind-Value="_nomeNovoCliente" Label="Nome" Variant="Variant.Outlined" Class="mb-2" Required="true" />
            <MudTextField T="string" @bind-Value="_enderecoNovoCliente" Label="Endereço" Variant="Variant.Outlined" Class="mb-4" Required="true" />
        }

        <MudSelect T="FormaPagamento" @bind-Value="_formaPagamento" Label="Forma de pagamento" Variant="Variant.Outlined" Class="mb-4">
            @foreach (var forma in Enum.GetValues<FormaPagamento>())
            {
                <MudSelectItem T="FormaPagamento" Value="forma">@RotuloFormaPagamento(forma)</MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Itens da venda</MudText>

        @foreach (var item in _itens)
        {
            <div class="d-flex gap-2 align-center mb-2">
                <MudSelect T="Guid" Value="item.ProdutoId" ValueChanged="@(id => item.ProdutoId = id)" Label="Produto" Variant="Variant.Outlined" Style="flex: 2;">
                    @foreach (var produto in _produtos)
                    {
                        <MudSelectItem T="Guid" Value="produto.Id">@produto.Nome (@produto.QuantidadeEstoque em estoque)</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="item.Quantidade" Label="Qtd" Variant="Variant.Outlined" Min="1" Style="flex: 1;" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => _itens.Remove(item))" />
            </div>
        }

        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AdicionarItem" Class="mb-4">Adicionar produto</MudButton>

        <MudNumericField T="decimal" @bind-Value="_desconto" Label="Desconto" Variant="Variant.Outlined" Format="N2" Class="mb-4" Min="0" />

        <MudText Typo="Typo.h6" Class="mb-2">Total: @CalcularValorBrutoPreview().ToString("C")</MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmarAsync" Disabled="_salvando">
            Registrar Venda
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _telefone = "";
    private bool _telefonePesquisado;
    private ClienteEncontrado? _clienteEncontrado;
    private string _nomeNovoCliente = "";
    private string _enderecoNovoCliente = "";
    private FormaPagamento _formaPagamento = FormaPagamento.Dinheiro;
    private decimal _desconto;
    private readonly List<ItemVendaEdit> _itens = [];
    private IReadOnlyList<ProdutoListItem> _produtos = [];
    private string? _errorMessage;
    private bool _salvando;

    protected override async Task OnInitializedAsync()
    {
        _produtos = await Sender.Send(new ListarProdutosQuery());
    }

    private async Task BuscarClienteAsync()
    {
        if (string.IsNullOrWhiteSpace(_telefone))
        {
            _telefonePesquisado = false;
            _clienteEncontrado = null;
            return;
        }

        _clienteEncontrado = await Sender.Send(new BuscarClientePorTelefoneQuery(_telefone));
        _telefonePesquisado = true;
    }

    private void AdicionarItem()
    {
        _itens.Add(new ItemVendaEdit(_produtos.Count > 0 ? _produtos[0].Id : Guid.Empty, 1));
    }

    private decimal CalcularValorBrutoPreview()
    {
        var bruto = _itens.Sum(item =>
        {
            var produto = _produtos.FirstOrDefault(p => p.Id == item.ProdutoId);
            if (produto is null)
            {
                return 0m;
            }

            var preco = _formaPagamento == FormaPagamento.GasDoPovo ? produto.PrecoGasDoPovo : produto.PrecoVenda;
            return preco * item.Quantidade;
        });

        return Math.Max(0m, bruto - _desconto);
    }

    private static string RotuloFormaPagamento(FormaPagamento forma) => forma switch
    {
        FormaPagamento.Pix => "Pix",
        FormaPagamento.Debito => "Débito",
        FormaPagamento.Credito => "Crédito",
        FormaPagamento.Dinheiro => "Dinheiro",
        FormaPagamento.Fiado => "Fiado",
        FormaPagamento.GasDoPovo => "Gás do Povo",
        _ => forma.ToString(),
    };

    private async Task ConfirmarAsync()
    {
        _salvando = true;
        _errorMessage = null;
        try
        {
            var itens = _itens
                .Where(i => i.ProdutoId != Guid.Empty && i.Quantidade > 0)
                .Select(i => new ItemVendaInput(i.ProdutoId, i.Quantidade))
                .ToList();

            var command = new RegistrarVendaCommand(
                _telefone,
                _clienteEncontrado is null ? _nomeNovoCliente : null,
                _clienteEncontrado is null ? _enderecoNovoCliente : null,
                _formaPagamento,
                _desconto,
                itens);

            var result = await Sender.Send(command);

            await VendasNotifier.NotificarVendaRegistrada();
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private sealed class ItemVendaEdit(Guid produtoId, int quantidade)
    {
        public Guid ProdutoId { get; set; } = produtoId;
        public int Quantidade { get; set; } = quantidade;
    }
}
