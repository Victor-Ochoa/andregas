@using AndreGas.Domain.Enums
@using AndreGas.Web.Common
@using AndreGas.Web.Features.Estoque.Listar
@using AndreGas.Web.Features.Vendas.NovaVenda
@using FluentValidation
@using Mediator

@inject ISender Sender
@inject VendasAtualizadasNotifier VendasNotifier

<MudDialog>
    <DialogContent>
        <MudAutocomplete T="ClienteSugestao" @bind-Value="_clienteSelecionado"
                         SearchFunc="BuscarClientesAsync"
                         ToStringFunc="@(cliente => cliente is null ? "" : $"{cliente.Nome} - {cliente.Telefone} - {cliente.Endereco}")"
                         Label="Buscar cliente (nome, telefone ou endereço)" Variant="Variant.Outlined"
                         Class="mb-2" Immediate="true" Clearable="true"
                         CoerceValue="false" ResetValueOnEmptyText="false"
                         MinCharacters="0" DebounceInterval="300"
                         @bind-Value:after="ClienteSelecionadoMudou" />

        @if (_clienteSelecionado is not null)
        {
            <MudAlert Severity="MudBlazor.Severity.Success" Class="mb-4">
                Cliente: <strong>@_clienteSelecionado.Nome</strong> — @_clienteSelecionado.Endereco<br />
                Saldo devedor atual: @_clienteSelecionado.SaldoDevedor.ToString("C")
            </MudAlert>
        }
        else if (_buscaSemResultados)
        {
            <MudAlert Severity="MudBlazor.Severity.Info" Class="mb-4">
                Nenhum cliente encontrado. Preencha os dados abaixo para cadastrá-lo.
            </MudAlert>
            <MudTextField T="string" @bind-Value="_nomeNovoCliente" Label="Nome" Variant="Variant.Outlined" Class="mb-2" Required="true" />
            <MudTextField T="string" @bind-Value="_telefoneNovoCliente" Label="Telefone" Variant="Variant.Outlined" Class="mb-2" Required="true" />
            <MudTextField T="string" @bind-Value="_enderecoNovoCliente" Label="Endereço" Variant="Variant.Outlined" Class="mb-4" Required="true" />
        }

        <MudSelect T="FormaPagamento" @bind-Value="_formaPagamento" Label="Forma de pagamento" Variant="Variant.Outlined" Class="mb-4">
            @foreach (var forma in Enum.GetValues<FormaPagamento>())
            {
                <MudSelectItem T="FormaPagamento" Value="forma">@RotuloFormaPagamento(forma)</MudSelectItem>
            }
        </MudSelect>

        <MudText Typo="Typo.subtitle2" Class="mb-2">Itens da venda</MudText>

        @foreach (var item in _itens)
        {
            <div class="d-flex gap-2 align-center mb-2">
                <MudSelect T="Guid" Value="item.ProdutoId" ValueChanged="@(id => item.ProdutoId = id)" Label="Produto" Variant="Variant.Outlined" Style="flex: 2;">
                    @foreach (var produto in _produtos)
                    {
                        <MudSelectItem T="Guid" Value="produto.Id">@produto.Nome (@produto.QuantidadeEstoque em estoque)</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="item.Quantidade" Label="Qtd" Variant="Variant.Outlined" Min="1" Style="flex: 1;" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => _itens.Remove(item))" />
            </div>
        }

        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AdicionarItem" Class="mb-4">Adicionar produto</MudButton>

        <div class="d-flex gap-2">
            <MudNumericField T="decimal" @bind-Value="_desconto" Label="Desconto" Variant="Variant.Outlined" Format="N2" Class="mb-4" Min="0" Style="flex: 1;" />
            <MudNumericField T="decimal" @bind-Value="_valorEntrega" Label="Valor de entrega" Variant="Variant.Outlined" Format="N2" Class="mb-4" Min="0" Style="flex: 1;" />
        </div>

        <MudText Typo="Typo.h6" Class="mb-2">Total: @CalcularValorTotalPreview().ToString("C")</MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmarAsync" Disabled="_salvando">
            Registrar Venda
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private ClienteSugestao? _clienteSelecionado;
    private bool _buscaSemResultados;
    private string _nomeNovoCliente = "";
    private string _telefoneNovoCliente = "";
    private string _enderecoNovoCliente = "";
    private FormaPagamento _formaPagamento = FormaPagamento.Dinheiro;
    private decimal _desconto;
    private decimal _valorEntrega;
    private readonly List<ItemVendaEdit> _itens = [];
    private IReadOnlyList<ProdutoListItem> _produtos = [];
    private string? _errorMessage;
    private bool _salvando;

    protected override async Task OnInitializedAsync()
    {
        _produtos = await Sender.Send(new ListarProdutosQuery());
    }

    private async Task<IEnumerable<ClienteSugestao>> BuscarClientesAsync(string termo, CancellationToken cancellationToken)
    {
        var sugestoes = await Sender.Send(new BuscarClientePorTermoQuery(termo), cancellationToken);

        // Só mostra o cadastro rápido quando o operador buscou um termo não vazio sem resultado.
        if (string.IsNullOrWhiteSpace(termo))
        {
            _buscaSemResultados = false;
            _clienteSelecionado = null;
        }
        else if (!sugestoes.Any() && _clienteSelecionado is null)
        {
            _buscaSemResultados = true;
            _valorEntrega = 0m;
        }
        else
        {
            _buscaSemResultados = false;
        }

        return sugestoes;
    }

    private void ClienteSelecionadoMudou()
    {
        if (_clienteSelecionado is not null)
        {
            _buscaSemResultados = false;
            // Sugere o último valor de entrega usado pelo cliente (0 se ainda não houve venda).
            _valorEntrega = _clienteSelecionado.UltimaValorEntrega;
        }
        else
        {
            _valorEntrega = 0m;
        }
    }

    private void AdicionarItem()
    {
        _itens.Add(new ItemVendaEdit(_produtos.Count > 0 ? _produtos[0].Id : Guid.Empty, 1));
    }

    private decimal CalcularValorTotalPreview()
    {
        var bruto = _itens.Sum(item =>
        {
            var produto = _produtos.FirstOrDefault(p => p.Id == item.ProdutoId);
            if (produto is null)
            {
                return 0m;
            }

            var preco = _formaPagamento == FormaPagamento.GasDoPovo ? produto.PrecoGasDoPovo : produto.PrecoVenda;
            return preco * item.Quantidade;
        });

        return Math.Max(0m, bruto - _desconto + _valorEntrega);
    }

    private static string RotuloFormaPagamento(FormaPagamento forma) => forma switch
    {
        FormaPagamento.Pix => "Pix",
        FormaPagamento.Debito => "Débito",
        FormaPagamento.Credito => "Crédito",
        FormaPagamento.Dinheiro => "Dinheiro",
        FormaPagamento.Fiado => "Fiado",
        FormaPagamento.GasDoPovo => "Gás do Povo",
        _ => forma.ToString(),
    };

    private async Task ConfirmarAsync()
    {
        _salvando = true;
        _errorMessage = null;
        try
        {
            var itens = _itens
                .Where(i => i.ProdutoId != Guid.Empty && i.Quantidade > 0)
                .Select(i => new ItemVendaInput(i.ProdutoId, i.Quantidade))
                .ToList();

            var command = new RegistrarVendaCommand(
                _clienteSelecionado?.Id,
                _clienteSelecionado is null ? _nomeNovoCliente : null,
                _clienteSelecionado is null ? _telefoneNovoCliente : null,
                _clienteSelecionado is null ? _enderecoNovoCliente : null,
                _formaPagamento,
                _desconto,
                itens,
                ValorEntrega: _valorEntrega);

            var result = await Sender.Send(command);

            await VendasNotifier.NotificarVendaRegistrada();
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    private sealed class ItemVendaEdit(Guid produtoId, int quantidade)
    {
        public Guid ProdutoId { get; set; } = produtoId;
        public int Quantidade { get; set; } = quantidade;
    }
}