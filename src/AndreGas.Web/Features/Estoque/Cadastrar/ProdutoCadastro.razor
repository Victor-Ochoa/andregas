@page "/estoque/novo"
@attribute [Authorize(Policy = AndreGas.Web.Common.Authorization.Politicas.ApenasAdmin)]
@attribute [Authorize(Policy = AndreGas.Web.Common.Authorization.Politicas.ApenasEmpresa)]
@rendermode InteractiveServer

@using AndreGas.Domain.Enums
@using AndreGas.Web.Common
@using AndreGas.Web.Features.Estoque.Cadastrar
@using FluentValidation
@using Mediator

@inject ISender Sender
@inject NavigationManager NavigationManager
@inject IdentidadeEmpresaService Identidade

<PageTitle>@Identidade.Titulo("Novo Produto")</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Novo Produto</MudText>

<MudPaper Class="pa-6" Style="max-width: 600px;">
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
    }

    <MudTextField T="string" @bind-Value="_nome" Label="Nome" Variant="Variant.Outlined" Class="mb-4" Required="true" />

    <MudSelect T="TipoProduto" @bind-Value="_tipo" Label="Tipo" Variant="Variant.Outlined" Class="mb-4">
        @foreach (var tipo in Enum.GetValues<TipoProduto>())
        {
            <MudSelectItem T="TipoProduto" Value="tipo">@tipo</MudSelectItem>
        }
    </MudSelect>

    <MudNumericField T="decimal" @bind-Value="_precoVenda" Label="Preço de venda" Variant="Variant.Outlined" Class="mb-4" Format="N2" />
    <MudNumericField T="decimal" @bind-Value="_precoCusto" Label="Preço de custo" Variant="Variant.Outlined" Class="mb-4" Format="N2" />
    <MudNumericField T="decimal" @bind-Value="_precoGasDoPovo" Label="Preço Gás do Povo" Variant="Variant.Outlined" Class="mb-4" Format="N2" />
    <MudNumericField T="int" @bind-Value="_estoqueMinimo" Label="Estoque mínimo" Variant="Variant.Outlined" Class="mb-4" />

    <MudSwitch T="bool" @bind-Value="_controlaVasilhame" Label="Controla vasilhame" Color="Color.Primary" Class="mb-2" />

    @if (_controlaVasilhame)
    {
        <MudNumericField T="int" @bind-Value="_quantidadeVasilhamesInicial" Label="Vasilhames disponíveis (inicial)" Variant="Variant.Outlined" Class="mb-4" Min="0" />
    }

    <MudSwitch T="bool" @bind-Value="_avisarRecompra" Label="Avisar recompra" Color="Color.Primary" Class="mb-2" />

    @if (_avisarRecompra)
    {
        <MudNumericField T="int" @bind-Value="_diasPadraoRecompra" Label="Dias padrão para recompra (ex.: 45)" Variant="Variant.Outlined" Class="mb-4" Min="0" />
    }

    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarAsync" Disabled="_salvando">
            Salvar
        </MudButton>
        <MudButton Variant="Variant.Text" Href="/estoque">Cancelar</MudButton>
    </div>
</MudPaper>

@code {
    private string _nome = "";
    private TipoProduto _tipo = TipoProduto.Gas;
    private decimal _precoVenda;
    private decimal _precoCusto;
    private decimal _precoGasDoPovo;
    private int _estoqueMinimo;
    private bool _controlaVasilhame;
    private int _quantidadeVasilhamesInicial;
    private bool _avisarRecompra;
    private int _diasPadraoRecompra;
    private string? _errorMessage;
    private bool _salvando;

    private async Task SalvarAsync()
    {
        _salvando = true;
        _errorMessage = null;
        try
        {
            var produtoId = await Sender.Send(new CadastrarProdutoCommand(
                _nome, _tipo, _precoVenda, _precoCusto, _precoGasDoPovo, _estoqueMinimo,
                _controlaVasilhame, _quantidadeVasilhamesInicial, _avisarRecompra, _diasPadraoRecompra));
            NavigationManager.NavigateTo("/estoque");
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        finally
        {
            _salvando = false;
        }
    }
}
