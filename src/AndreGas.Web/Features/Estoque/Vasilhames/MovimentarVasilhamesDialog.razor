@using AndreGas.Domain.Enums
@using AndreGas.Web.Features.Estoque.Vasilhames
@using FluentValidation
@using Mediator

@inject ISender Sender

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Movimentar vasilhames</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-2">Produto: <strong>@ProdutoNome</strong></MudText>
        <MudText Typo="Typo.body2" Class="mb-4">Disponíveis atuais: <strong>@DisponiveisAtuais</strong> · Emprestados: <strong>@EmprestadosAtuais</strong></MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        <MudSelect T="TipoMovimentacaoEstoque" @bind-Value="_tipo" Label="Tipo de movimentação" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem T="TipoMovimentacaoEstoque" Value="TipoMovimentacaoEstoque.Entrada">Entrada (adiciona vazios)</MudSelectItem>
            <MudSelectItem T="TipoMovimentacaoEstoque" Value="TipoMovimentacaoEstoque.Saida">Saída (remove vazios)</MudSelectItem>
            <MudSelectItem T="TipoMovimentacaoEstoque" Value="TipoMovimentacaoEstoque.Ajuste">Ajuste (define o total de vazios)</MudSelectItem>
        </MudSelect>

        <MudNumericField T="int" @bind-Value="_quantidade" Label="@(_tipo == TipoMovimentacaoEstoque.Ajuste ? "Novo total de vazios" : "Quantidade")" Variant="Variant.Outlined" Class="mb-4" Min="0"
                         HelperText="@HelperQuantidade" />
        <MudTextField T="string" @bind-Value="_observacao" Label="Observação (opcional)" Variant="Variant.Outlined" Class="mb-4" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmarAsync" Disabled="_salvando">@(_tipo == TipoMovimentacaoEstoque.Ajuste ? "Ajustar vazios" : "Confirmar")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid ProdutoId { get; set; }

    [Parameter]
    public string ProdutoNome { get; set; } = "";

    [Parameter]
    public int DisponiveisAtuais { get; set; }

    [Parameter]
    public int EmprestadosAtuais { get; set; }

    private TipoMovimentacaoEstoque _tipo = TipoMovimentacaoEstoque.Entrada;
    private int _quantidade = 1;

    /// <summary>Helper do campo quantidade conforme o tipo (ajuste define o total).</summary>
    private string HelperQuantidade => _tipo == TipoMovimentacaoEstoque.Ajuste
        ? "Define o total; não soma à quantidade atual"
        : "Quantidade de vazios a mover";
    private string? _observacao;
    private string? _errorMessage;
    private bool _salvando;

    private async Task ConfirmarAsync()
    {
        _salvando = true;
        _errorMessage = null;
        try
        {
            await Sender.Send(new RegistrarMovimentacaoVasilhameCommand(
                ProdutoId, _tipo, _quantidade, _observacao));
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}