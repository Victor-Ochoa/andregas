@using AndreGas.Web.Features.Clientes.Listar
@using AndreGas.Web.Features.Clientes.Emprestimos
@using AndreGas.Web.Features.Estoque.Listar
@using AndreGas.Web.Features.Estoque.Vasilhames
@using FluentValidation
@using Mediator

@inject ISender Sender

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Titulo</MudText>
    </TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        <MudSelect T="Guid" Value="_produtoIdEditavel" ValueChanged="AoMudarProduto" Label="Produto" Variant="Variant.Outlined" Class="mb-4"
                   ToStringFunc="@(id => ObterNomeProduto(id))" Disabled="_produtos.Count == 0">
            @foreach (var produto in _produtos.Where(p => p.ControlaVasilhame))
            {
                <MudSelectItem T="Guid" Value="produto.Id">
                    @produto.Nome
                    <MudText Typo="Typo.caption" Class="ml-2" Style="color: var(--mud-palette-grey)">disponível: @produto.QuantidadeVasilhames · emprestados: @produto.QuantidadeVasilhamesEmprestados</MudText>
                </MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="Guid" @bind-Value="_clienteId" Label="Cliente" Variant="Variant.Outlined" Class="mb-4" ToStringFunc="@(id => ClienteNome(id))" Disabled="_clientes.Count == 0 || ClienteIdInicial is not null">
            @foreach (var cliente in _clientes)
            {
                <MudSelectItem T="Guid" Value="cliente.ClienteId">@cliente.ClienteNome (@cliente.Telefone)
                    @if (cliente.QuantidadeEmprestada > 0)
                    {
                        <MudText Typo="Typo.caption" Class="ml-2" Style="color: var(--mud-palette-grey)">deve @cliente.QuantidadeEmprestada</MudText>
                    }
                </MudSelectItem>
            }
        </MudSelect>

        <MudNumericField T="int" @bind-Value="_quantidade" Label="Quantidade" Variant="Variant.Outlined" Class="mb-4" Min="1" />

        <MudTextField T="string" @bind-Value="_observacao" Label="Observação (opcional)" Variant="Variant.Outlined" Class="mb-4" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmarAsync" Disabled="_salvando">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public bool EhEmprestimo { get; set; }

    [Parameter]
    public string ProdutoNome { get; set; } = "";

    [Parameter]
    public Guid ProdutoId { get; set; }

    /// <summary>Cliente já fixado (ex.: tela do cliente) para pré-selecionar no MudSelect.
    /// Quando nulo, mantém o comportamento original: seleciona o primeiro cliente da lista.</summary>
    [Parameter]
    public Guid? ClienteIdInicial { get; set; }

    private string Titulo => EhEmprestimo ? "Registrar empréstimo" : "Registrar devolução";

    private IReadOnlyList<ProdutoListItem> _produtos = [];
    private Guid _produtoIdEditavel;
    private string? ObterNomeProduto(Guid produtoId) => _produtos.FirstOrDefault(p => p.Id == produtoId)?.Nome ?? "";

    private IReadOnlyList<ClienteComEmprestimoItem> _clientes = [];
    private Guid _clienteId;
    private int _quantidade = 1;
    private string? _observacao;
    private string? _errorMessage;
    private bool _salvando;

    protected override async Task OnInitializedAsync()
    {
        _produtos = await Sender.Send(new ListarProdutosQuery(IncluirInativos: false));

        // O produto chega fixado do caller (tela de estoque: o item da linha; tela do cliente:
        // o padrão do último empréstimo) — mas segue editável aqui (o operador pode trocar).
        _produtoIdEditavel = ProdutoId;

        await CarregarClientesAsync();

        if (ClienteIdInicial is not null && _clientes.Any(c => c.ClienteId == ClienteIdInicial.Value))
        {
            _clienteId = ClienteIdInicial.Value;
        }
        else if (_clientes.Count > 0)
        {
            _clienteId = _clientes[0].ClienteId;
        }
        else if (ClienteIdInicial is not null)
        {
            // Cliente fixo da tela do cliente: mesmo sem empréstimo aberto, mantém selecionado.
            _clienteId = ClienteIdInicial.Value;
        }
    }

    /// <summary>
    /// Na devolução, lista só quem tem o produto emprestado em aberto (quem pode devolver). Na
    /// tela do cliente (ClienteIdInicial fixo) sempre precisa dele, então lista o cliente de
    /// qualquer forma; no empréstimo, qualquer cliente pode pegar vazio: lista todos.
    /// </summary>
    private async Task CarregarClientesAsync()
    {
        if (ClienteIdInicial is not null)
        {
            _clientes = (await Sender.Send(new ListarClientesQuery()))
                .Where(c => c.Id == ClienteIdInicial.Value)
                .Select(c => new ClienteComEmprestimoItem(c.Id, c.Nome, c.Telefone, c.QuantidadeVasilhamesEmprestados))
                .ToList();
        }
        else if (!EhEmprestimo)
        {
            _clientes = await Sender.Send(new ObterClientesComEmprestimoProdutoQuery(_produtoIdEditavel));
        }
        else
        {
            _clientes = (await Sender.Send(new ListarClientesQuery()))
                .Select(c => new ClienteComEmprestimoItem(c.Id, c.Nome, c.Telefone, c.QuantidadeVasilhamesEmprestados))
                .ToList();
        }

        // Sem cliente informado ainda, pré-seleciona o primeiro.
        if (_clienteId == Guid.Empty && _clientes.Count > 0)
        {
            _clienteId = _clientes[0].ClienteId;
        }
    }

    private async Task AoMudarProduto(Guid produtoId)
    {
        _produtoIdEditavel = produtoId;
        _clienteId = Guid.Empty;
        await CarregarClientesAsync();
    }

    private string ClienteNome(Guid clienteId)
    {
        var cliente = _clientes.FirstOrDefault(c => c.ClienteId == clienteId);
        return cliente?.ClienteNome ?? "";
    }

    private async Task ConfirmarAsync()
    {
        if (_clienteId == Guid.Empty)
        {
            _errorMessage = "Informe o cliente.";
            return;
        }

        _salvando = true;
        _errorMessage = null;
        try
        {
            if (_produtoIdEditavel == Guid.Empty)
            {
                _errorMessage = "Informe o produto.";
                return;
            }

            if (EhEmprestimo)
            {
                await Sender.Send(new RegistrarEmprestimoCommand(_clienteId, _produtoIdEditavel, _quantidade, _observacao));
            }
            else
            {
                await Sender.Send(new RegistrarDevolucaoVasilhameCommand(_clienteId, _produtoIdEditavel, _quantidade, _observacao));
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}