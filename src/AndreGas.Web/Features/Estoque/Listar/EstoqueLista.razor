@page "/estoque"
@rendermode InteractiveServer

@using AndreGas.Web.Features.Estoque.Editar
@using AndreGas.Web.Features.Estoque.Historico
@using AndreGas.Web.Features.Estoque.Listar
@using Mediator

@inject ISender Sender
@inject IDialogService DialogService

<PageTitle>Estoque — André Gas e Água</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Estoque</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBox" Href="/estoque/novo">
        Novo Produto
    </MudButton>
</div>

@if (_produtos is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_produtos.Count == 0)
{
    <MudText>Nenhum produto cadastrado ainda.</MudText>
}
else
{
    <MudTable Items="_produtos" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Preço venda</MudTh>
            <MudTh>Preço custo</MudTh>
            <MudTh>Preço Gás do Povo</MudTh>
            <MudTh>Estoque</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nome">@context.Nome</MudTd>
            <MudTd DataLabel="Tipo">@context.Tipo</MudTd>
            <MudTd DataLabel="Preço venda">@context.PrecoVenda.ToString("C")</MudTd>
            <MudTd DataLabel="Preço custo">@context.PrecoCusto.ToString("C")</MudTd>
            <MudTd DataLabel="Preço Gás do Povo">@context.PrecoGasDoPovo.ToString("C")</MudTd>
            <MudTd DataLabel="Estoque">
                <MudText Color="@(context.EstoqueBaixo ? Color.Error : Color.Default)">
                    @context.QuantidadeEstoque
                    @if (context.EstoqueBaixo)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Error" Class="ml-1" />
                    }
                </MudText>
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@(context.Ativo ? Color.Success : Color.Default)" Variant="@(context.Ativo ? Variant.Filled : Variant.Outlined)">
                    @(context.Ativo ? "Ativo" : "Inativo")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudButton Variant="Variant.Text" OnClick="@(() => AbrirHistoricoAsync(context))">Histórico</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => AbrirEdicaoAsync(context))">Editar</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => AbrirMovimentacaoAsync(context))">Movimentar</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private IReadOnlyList<ProdutoListItem>? _produtos;

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        // A tela de estoque lista TODOS os produtos, inclusive os desabilitados (para reativá-los).
        _produtos = await Sender.Send(new ListarProdutosQuery(IncluirInativos: true));
    }

    private async Task AbrirHistoricoAsync(ProdutoListItem produto)
    {
        var parameters = new DialogParameters<HistoricoEstoqueDialog>
        {
            { x => x.ProdutoId, produto.Id },
            { x => x.ProdutoNome, produto.Nome },
        };

        await DialogService.ShowAsync<HistoricoEstoqueDialog>("Histórico de estoque", parameters);
    }

    private async Task AbrirEdicaoAsync(ProdutoListItem produto)
    {
        var parameters = new DialogParameters<EditarProdutoDialog>
        {
            { x => x.ProdutoId, produto.Id },
        };

        var dialog = await DialogService.ShowAsync<EditarProdutoDialog>("Editar produto", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await CarregarAsync();
        }
    }

    private async Task AbrirMovimentacaoAsync(ProdutoListItem produto)
    {
        var parameters = new DialogParameters<MovimentarEstoqueDialog>
        {
            { x => x.ProdutoId, produto.Id },
            { x => x.ProdutoNome, produto.Nome },
        };

        var dialog = await DialogService.ShowAsync<MovimentarEstoqueDialog>("Movimentar estoque", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await CarregarAsync();
        }
    }
}
