@using AndreGas.Domain.Enums
@using AndreGas.Web.Features.Estoque.Editar
@using AndreGas.Web.Features.Estoque.Movimentar
@using FluentValidation
@using Mediator

@inject ISender Sender
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-4">Produto: <strong>@ProdutoNome</strong></MudText>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
        }

        <MudSelect T="TipoMovimentacaoEstoque" @bind-Value="_tipo" Label="Tipo de movimentação" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem T="TipoMovimentacaoEstoque" Value="TipoMovimentacaoEstoque.Entrada">Entrada</MudSelectItem>
            <MudSelectItem T="TipoMovimentacaoEstoque" Value="TipoMovimentacaoEstoque.Saida">Saída</MudSelectItem>
            <MudSelectItem T="TipoMovimentacaoEstoque" Value="TipoMovimentacaoEstoque.Ajuste">Ajuste (define o total em estoque)</MudSelectItem>
        </MudSelect>

        <MudNumericField T="int" @bind-Value="_quantidade" Label="Quantidade" Variant="Variant.Outlined" Class="mb-4" Min="1" />
        <MudTextField T="string" @bind-Value="_motivo" Label="Motivo (opcional)" Variant="Variant.Outlined" Class="mb-4" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmarAsync" Disabled="_salvando">Confirmar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid ProdutoId { get; set; }

    [Parameter]
    public string ProdutoNome { get; set; } = "";

    private TipoMovimentacaoEstoque _tipo = TipoMovimentacaoEstoque.Entrada;
    private int _quantidade = 1;
    private string? _motivo;
    private string? _errorMessage;
    private bool _salvando;

    private async Task ConfirmarAsync()
    {
        _salvando = true;
        _errorMessage = null;
        try
        {
            var adicionarVasilhames = false;
            var quantidadeVasilhamesAdicionar = 0;

            // Entrada com controle de vasilhame: se a quantidade recebida supera os vazios
            // disponíveis, oferece adicionar vasilhames automaticamente.
            if (_tipo == TipoMovimentacaoEstoque.Entrada)
            {
                var produto = await Sender.Send(new ObterProdutoQuery(ProdutoId));
                if (produto is { ControlaVasilhame: true } && _quantidade > produto.QuantidadeVasilhames)
                {
                    var parameters = new DialogParameters<AdicionarVasilhamesDialog>
                    {
                        { x => x.ProdutoNome, ProdutoNome },
                        { x => x.Quantidade, _quantidade },
                        { x => x.VasilhamesDisponiveis, produto.QuantidadeVasilhames },
                    };
                    var dialog = await DialogService.ShowAsync<AdicionarVasilhamesDialog>(
                        "Adicionar vasilhames", parameters);
                    var resultado = await dialog.Result;
                    if (resultado is { Canceled: false } && resultado.Data is int quantidadeEscolhida)
                    {
                        quantidadeVasilhamesAdicionar = quantidadeEscolhida;
                        // Só marca a flag quando houver vasilhames a adicionar (0 escolhido equivale a
                        // cancelar; senão o validator rejeita flag com quantidade zero).
                        adicionarVasilhames = quantidadeVasilhamesAdicionar > 0;
                    }
                }
            }

            await Sender.Send(new RegistrarMovimentacaoEstoqueCommand(
                ProdutoId, _tipo, _quantidade, _motivo,
                adicionarVasilhames, quantidadeVasilhamesAdicionar));
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ValidationException ex)
        {
            _errorMessage = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _salvando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
