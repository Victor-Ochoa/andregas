@using AndreGas.Web.Common.Tenancy
@using Microsoft.AspNetCore.Components.Authorization

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

@code {
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var isAuthenticated = state.User.Identity?.IsAuthenticated == true;

        if (!isAuthenticated)
        {
            // Não autenticado → fluxo de login com returnUrl.
            var returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
            return;
        }

        // Autenticado. Super admin da central (claim EhSuperAdmin, não IsInRole: o principal
        // impersonado tem a claim "false" e é um usuário de empresa) tentando uma página de
        // domínio → volta para a central em vez de cair em "sem autorização".
        var ehSuperAdmin = bool.TryParse(
            state.User.FindFirst(TenantContext.ClaimEhSuperAdmin)?.Value, out var valor) && valor;

        if (ehSuperAdmin)
        {
            NavigationManager.NavigateTo("/central", forceLoad: true);
            return;
        }

        // Qualquer outro autenticado sem a role/política exigida → página de "Sem Autorização".
        NavigationManager.NavigateTo("/sem-autorizacao", forceLoad: true);
    }
}