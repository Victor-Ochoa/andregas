@inherits LayoutComponentBase
@rendermode InteractiveServer
@using AndreGas.Web.Features.Vendas.NovaVenda
@using AndreGas.Web.Theme

@inject IDialogService DialogService

<MudThemeProvider Theme="AndreGasTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="false" Class="app-bar-shell">
        <MudAvatar Color="Color.Primary" Class="mr-3">A</MudAvatar>
        <MudText Typo="Typo.h6" Class="mr-6">André Gas e Água</MudText>

        <MudButtonGroup Variant="Variant.Text" Color="Color.Inherit" Class="d-none d-md-flex app-nav-group">
            <MudButton Href="/" StartIcon="@Icons.Material.Filled.Dashboard">Home</MudButton>
            <MudButton Href="/clientes" StartIcon="@Icons.Material.Filled.People">Clientes</MudButton>
            <MudButton Href="/estoque" StartIcon="@Icons.Material.Filled.Inventory">Estoque</MudButton>
        </MudButtonGroup>

        <MudSpacer />

        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PointOfSale" Class="mr-2 app-sale-button" OnClick="AbrirNovaVendaAsync">
            Nova Venda
        </MudButton>

        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Dense="true">
                    <MudMenuItem Disabled="true">@context.User.Identity?.Name</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem>
                        <form action="/logout" method="post">
                            <AntiforgeryToken />
                            <button type="submit" class="mud-button-root mud-menu-item" style="background:none;border:none;width:100%;text-align:left;">
                                Sair
                            </button>
                        </form>
                    </MudMenuItem>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="app-content-shell">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task AbrirNovaVendaAsync()
    {
        var dialog = await DialogService.ShowAsync<NovaVendaDialog>("Nova Venda", new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
        });

        await dialog.Result;
    }
}
