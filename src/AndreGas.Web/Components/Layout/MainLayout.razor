@inherits LayoutComponentBase
@using AndreGas.Web.Theme

<MudThemeProvider Theme="AndreGasTheme.Default" />

<MudLayout>
    <MudAppBar Elevation="0" Dense="false" Class="app-bar-shell">
        <MudAvatar Color="Color.Primary" Class="mr-3">A</MudAvatar>
        <MudText Typo="Typo.h6" Class="mr-6">André Gas e Água</MudText>

        <MudButtonGroup Variant="Variant.Text" Color="Color.Inherit" Class="d-none d-md-flex app-nav-group">
            <MudButton Href="/" StartIcon="@Icons.Material.Filled.Dashboard">Home</MudButton>
            <MudButton Href="/clientes" StartIcon="@Icons.Material.Filled.People">Clientes</MudButton>
            <MudButton Href="/estoque" StartIcon="@Icons.Material.Filled.Inventory">Estoque</MudButton>
        </MudButtonGroup>

        <MudSpacer />

        <TopMenuActions />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="app-content-shell">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
