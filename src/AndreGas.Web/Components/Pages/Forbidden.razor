@page "/sem-autorizacao"
@layout AndreGas.Web.Components.Layout.MainLayout

<PageTitle>Sem autorização — André Gas e Água</PageTitle>

<div class="d-flex flex-column align-center justify-center text-center pa-8" style="min-height: 60vh;">
    <MudAvatar Color="Color.Secondary" Class="mb-4" Size="Size.Large">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" />
    </MudAvatar>
    <MudText Typo="Typo.h4" Align="Align.Center" Class="mb-2" Style="font-weight: 700;">
        Sem autorização
    </MudText>
    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-6" Style="max-width: 480px;">
        Você não tem permissão para acessar esta página. Se você acredita que deveria ter acesso,
        entre em contato com o administrador do sistema.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home" Href="/">
        Voltar para o início
    </MudButton>
</div>